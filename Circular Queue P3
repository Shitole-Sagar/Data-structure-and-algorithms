#include<iostream>
using namespace std;

#define SIZE 5

class CircularQueue
{
    int q[SIZE], front, rear;

public:
    CircularQueue()
    {
        front = rear = -1;
    }

    void enqueue()
    {
        int x;
        if (front == (rear + 1) % SIZE)
        {
            cout << "Queue Overflow";
            return;
        }

        cout << "Enter Element: ";
        cin >> x;

        if (front == -1)
            front = rear = 0;
        else
            rear = (rear + 1) % SIZE;

        q[rear] = x;
    }

    void dequeue()
    {
        if (front == -1)
        {
            cout << "Queue Underflow";
            return;
        }

        cout << "Deleted Element: " << q[front];

        if (front == rear)
            front = rear = -1;
        else
            front = (front + 1) % SIZE;
    }

    void display()
    {
        if (front == -1)
        {
            cout << "Queue is Empty";
            return;
        }

        int i = front;
        cout << "Queue: ";

        while (true)
        {
            cout << q[i] << " ";
            if (i == rear)
                break;
            i = (i + 1) % SIZE;
        }
    }
};

int main()
{
    CircularQueue q;
    int ch;

    do
    {
        cout << "\n1.Enqueue\n2.Dequeue\n3.Display\n4.Exit\n";
        cout << "Enter Choice: ";
        cin >> ch;

        switch (ch)
        {
            case 1: q.enqueue(); break;
            case 2: q.dequeue(); break;
            case 3: q.display(); break;
            case 4: cout << "Program End"; break;
            default: cout << "Invalid Choice";
        }

    } while (ch != 4);

    return 0;
}
